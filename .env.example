# Wheelhouse configuration. Copy to `.env` and adjust. Never commit `.env`.

# Port the app listens on (Jellyfin itself normally uses 8096).
PORT=8787
# 0.0.0.0 = reachable from other devices on your home network; 127.0.0.1 = this computer only.
HOST=0.0.0.0

# Address of your Jellyfin server *as seen from this computer*. Leave empty to
# use the built-in sample library instead. No credentials go here: each person
# signs in with their own Jellyfin username and password.
JELLYFIN_URL=http://127.0.0.1:8096

# auto (Jellyfin when JELLYFIN_URL is set, otherwise sample library) | jellyfin | mock
MEDIA_SOURCE=auto

# Password for the sample library (any username works). Only used in sample mode.
MOCK_PASSWORD=demo

# Where the database and uploaded collection artwork are stored. Back this folder up.
DATA_DIR=./data

# Automatic daily backups of the database and artwork (the newest BACKUP_KEEP are kept).
# Point BACKUP_DIR at another drive (e.g. /Volumes/LaCie/Wheelhouse Backups) for extra safety.
BACKUP_DIR=
BACKUP_KEEP=14
# Warn (Settings, and a phone notification when ntfy is set up) below this much free space.
LOW_SPACE_GB=30
# Install new versions by themselves when nothing is ripping or playing (needs the launchd service).
AUTO_UPDATE=1

# How long a sign-in lasts without use, in days.
SESSION_DAYS=30

# How often (seconds) the library index is refreshed from Jellyfin. Settings →
# Server → "Refresh library" forces an immediate refresh.
CATALOG_TTL_SECONDS=300

# Cookie "Secure" flag: auto (secure when the request arrived over HTTPS) | true | false
COOKIE_SECURE=auto
# Set to true only when running behind a reverse proxy (Caddy, nginx, Tailscale Serve)
# so the app trusts X-Forwarded-* headers for HTTPS detection and client IPs.
TRUST_PROXY=false

# --- Automatic disc ripping (set up with: npm run setup:ripper) ---------------
# Insert a DVD and Wheelhouse rips it with MakeMKV, compresses it with HandBrake,
# files it in MOVIES_DIR, adds it to Jellyfin and sends a phone notification.
RIPPER_ENABLED=false
MOVIES_DIR=/Volumes/LaCie/Movies
# TV season discs are filed here as Show (Year)/Season 01/Show S01E01.mp4.
# Add it to Jellyfin as a "Shows" library.
TV_DIR=/Volumes/LaCie/TV Shows
RIPS_DIR=/Volumes/LaCie/Rips
# Leave empty to use the standard install locations.
MAKEMKVCON=
HANDBRAKE_CLI=
# HandBrake preset and quality (lower number = better quality, bigger file; 18–22 is typical).
HANDBRAKE_PRESET=Fast 1080p30
HANDBRAKE_QUALITY=20
# Subtitle languages to keep as switchable tracks (3-letter codes, e.g. eng,spa), or "none".
HANDBRAKE_SUBTITLES=eng
# Quit the Mac's DVD Player when it opens on its own for an inserted disc (default on a Mac).
RIP_CLOSE_DVD_PLAYER=true
# Jellyfin → Dashboard → API Keys. Lets Wheelhouse look up movie names and add them instantly.
JELLYFIN_API_KEY=
# Phone notifications through the free ntfy app: subscribe to this (random) topic name.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Address opened when you tap a notification, e.g. http://wheelhouse.local:8787
WHEELHOUSE_PUBLIC_URL=
